# Preferred environment file for the whole project
# Copy this file to .env at the repository root.

PORT=5000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/dakhilaa
# If your password contains @, #, /, ?, %, or other URI characters,
# either percent-encode it in MONGODB_URI or use these separate values:
# MONGODB_USERNAME=your-mongodb-user
# MONGODB_PASSWORD=your-raw-password
# MONGODB_HOST=cluster0.example.mongodb.net
# MONGODB_DATABASE=dakhilaa

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Email (Gmail)
EMAIL_SERVICE=gmail
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password

# Razorpay
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret

# App URLs
DIAGNOSTIC_TEST_URL=https://dakhilaa.com/diagnostic
UPGRADE_URL=https://dakhilaa.com/plans
DASHBOARD_URL=https://dakhilaa.com/dashboard
